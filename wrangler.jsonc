{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moh-v2",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-05",

  "assets": {
    "directory": "./Public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/log-in", "/user", "/user/*", "/manager", "/manager/*", "/info/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moh-v2-db",
      "database_id": "f2c6a31b-2b8b-4ddf-bf7b-665eff9a288f"
    }
  ],

  "ai": { "binding": "AI" },

  "vars": {
    "ADMIN_MOBILES": ""
  },

  "observability": { "enabled": true }
}
